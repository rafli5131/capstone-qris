{
    "swagger": "2.0",
    "info": {
        "description": "High-performance QRIS payment microservice with Redis caching and optimistic locking.",
        "title": "QRIS Payment API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/",
    "paths": {
        "/api/qris/inquiry/image": {
            "post": {
                "security": [
                    {
                        "X-Client-Id": []
                    },
                    {
                        "X-Client-Key": []
                    }
                ],
                "description": "Get merchant data by QRIS image (QR code).",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "qris"
                ],
                "summary": "QRIS inquiry from image",
                "parameters": [
                    {
                        "type": "file",
                        "description": "QR code image",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.InquiryResponseEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/qris/inquiry/{qris_payload}": {
            "get": {
                "security": [
                    {
                        "X-Client-Id": []
                    },
                    {
                        "X-Client-Key": []
                    }
                ],
                "description": "Get merchant data by QRIS payload (decoded if URL-encoded).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "qris"
                ],
                "summary": "QRIS inquiry",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QRIS payload (raw or URL-encoded)",
                        "name": "qris_payload",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.InquiryResponseEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/qris/merchant/image": {
            "post": {
                "security": [
                    {
                        "X-Client-Id": []
                    },
                    {
                        "X-Client-Key": []
                    }
                ],
                "description": "Create or re-activate a merchant using a QRIS image (QR code).",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "merchant"
                ],
                "summary": "Add merchant from image",
                "parameters": [
                    {
                        "type": "file",
                        "description": "QR code image",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MerchantResponseEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/qris/payment": {
            "post": {
                "security": [
                    {
                        "X-Client-Id": []
                    },
                    {
                        "X-Client-Key": []
                    }
                ],
                "description": "Submit payment for a QRIS inquiry.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "qris"
                ],
                "summary": "Create payment",
                "parameters": [
                    {
                        "description": "Payment request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.PaymentRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/model.PaymentResponseEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/qris/status/{transaction_id}": {
            "get": {
                "security": [
                    {
                        "X-Client-Id": []
                    },
                    {
                        "X-Client-Key": []
                    }
                ],
                "description": "Fetch current status and final balance for a transaction.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transaction"
                ],
                "summary": "Get transaction status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Transaction ID",
                        "name": "transaction_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.TransactionStatusResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.ErrorResponse": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "model.InquiryResponse": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "fixed_amount": {
                    "type": "number"
                },
                "inquiry_id": {
                    "type": "string"
                },
                "merchant_id": {
                    "type": "string"
                },
                "merchant_name": {
                    "type": "string"
                },
                "terminal_id": {
                    "type": "string"
                }
            }
        },
        "model.InquiryResponseEnvelope": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/model.InquiryResponse"
                },
                "metadata": {
                    "$ref": "#/definitions/model.Metadata"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "model.MerchantResponse": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "is_new": {
                    "type": "boolean"
                },
                "mcc": {
                    "type": "string"
                },
                "merchant_id": {
                    "type": "string"
                },
                "merchant_name": {
                    "type": "string"
                }
            }
        },
        "model.MerchantResponseEnvelope": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/model.MerchantResponse"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "model.Metadata": {
            "type": "object",
            "properties": {
                "latency_ms": {
                    "type": "integer"
                },
                "source": {
                    "description": "\"cache\" or \"database\"",
                    "type": "string"
                }
            }
        },
        "model.PaymentRequest": {
            "type": "object",
            "required": [
                "amount",
                "inquiry_id",
                "payment_method",
                "pincode",
                "user_id"
            ],
            "properties": {
                "amount": {
                    "type": "number"
                },
                "inquiry_id": {
                    "type": "string"
                },
                "payment_method": {
                    "type": "string",
                    "enum": [
                        "balance"
                    ]
                },
                "pincode": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "model.PaymentResponse": {
            "type": "object",
            "properties": {
                "estimated_completion": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "transaction_id": {
                    "type": "string"
                }
            }
        },
        "model.PaymentResponseEnvelope": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/model.PaymentResponse"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "model.TransactionStatusResponse": {
            "type": "object",
            "properties": {
                "final_balance": {
                    "type": "number"
                },
                "status": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                },
                "transaction_id": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "X-Client-Id": {
            "type": "apiKey",
            "name": "X-Client-Id",
            "in": "header"
        },
        "X-Client-Key": {
            "type": "apiKey",
            "name": "X-Client-Key",
            "in": "header"
        }
    }
}